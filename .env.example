# Copy thành .env.local rồi điền key (file .env.local không được đưa lên GitHub)
GOOGLE_TTS_API_KEY=
# Tuỳ chọn: đổi giọng đọc (xem danh sách giọng của Google Cloud Text-to-Speech)
TTS_VOICE_EN=en-US-Neural2-F
TTS_VOICE_VI=vi-VN-Neural2-A
# Giọng macOS cho `npm run audio:mac` (tải giọng trong System Settings → Accessibility → Read & Speak → Manage Voices)
TTS_MAC_EN=Ava (Premium)
TTS_MAC_VI=com.apple.voice.enhanced.vi-VN.Linh
